# Copy this file to .env and fill in your values.
# The .env file is never committed — the server reads it at startup.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase: Settings → Database → URI).
DATABASE_URL=

# Max DB connections in the pool, per process (default 10). Raise only if the
# Supabase pooler can take it; with N instances the total is N × DB_POOL_MAX.
DB_POOL_MAX=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL (Settings → API → Project URL).
SUPABASE_URL=

# Public anon key — safe to expose in the browser (Settings → API → anon public).
SUPABASE_ANON_KEY=

# Service role key — has full DB access, keep secret (Settings → API → service_role).
# Runtime use: server-side account deletion via the Supabase Auth admin API
# (DELETE /auth/v1/admin/users/{id}) in POST /api/account/delete. Server-only:
# never sent to the browser, never in /api/config, never logged.
SUPABASE_SERVICE_KEY=

# JWT secret — NO LONGER USED at runtime. JWT verification is asymmetric-only
# (ES256/RS256 via JWKS); the HS256 fallback was removed. Kept for reference only.
SUPABASE_JWT_SECRET=

# ── TMDB ──────────────────────────────────────────────────────────────────────
# API key v3 (themoviedb.org → Settings → API → API Key).
# Without this, search and trending are disabled.
TMDB_API_KEY=

# TTL in seconds for the in-memory TMDB response cache (default 900). Set to 0
# to disable caching. TMDB data is user-independent, so caching is safe.
TMDB_CACHE_TTL=

# ── Discord webhooks ──────────────────────────────────────────────────────────
# Webhook URL for titles added to the watchlist ("Por ver").
DISCORD_WEBHOOK_PENDIENTE=

# Webhook URL for titles marked as watched ("Vistas").
DISCORD_WEBHOOK_VISTA=

# Fallback webhook used when the status-specific ones above are not set.
DISCORD_WEBHOOK_URL=

# Supabase UUID of the only account that triggers Discord notifications.
# If set, all other users are silenced. Leave empty to notify everyone.
DISCORD_OWNER_ID=

# Webhook for REDACTED error alerts: when an unhandled exception escapes the
# request handler (a real bug), a redacted traceback is posted here. Leave empty
# to disable error alerts. Use a SEPARATE channel from the activity webhooks.
DISCORD_WEBHOOK_ERRORS=

# ── Server ────────────────────────────────────────────────────────────────────
# HTTP port (default: 8000).
# PORT=8000
